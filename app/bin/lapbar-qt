#!/usr/bin/env python3
"""GUI entry point for the lapbar-qt tray app; runs without installation and without a venv."""
import os
import sys

_ROOT = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(_ROOT, ".."))
sys.path.insert(0, os.path.join(_ROOT, "..", "..", "backend"))

from lapbar_qt.tray import main  # noqa: E402

sys.exit(main())
